r","user_view_type":"public","site_admin":false},"committer":{"login":"Akshay4527","id":64081368,"node_id":"MDQ6VXNlcjY0MDgxMzY4","avatar_url":"https://avatars.githubusercontent.com/u/64081368?v=4","gravatar_id":"","url":"https://api.github.com/users/Akshay4527","html_url":"https://github.com/Akshay4527","followers_url":"https://api.github.com/users/Akshay4527/followers","following_url":"https://api.github.com/users/Akshay4527/following{/other_user}","gists_url":"https://api.github.com/users/Akshay4527/gists{/gist_id}","starred_url":"https://api.github.com/users/Akshay4527/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Akshay4527/subscriptions","organizations_url":"https://api.github.com/users/Akshay4527/orgs","repos_url":"https://api.github.com/users/Akshay4527/repos","events_url":"https://api.github.com/users/Akshay4527/events{/privacy}","received_events_url":"https://api.github.com/users/Akshay4527/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"36e4a824f340fdee7ed50937ba8e7f6bc7d17f81","url":"https://api.github.com/repos/pallets/flask/commits/36e4a824f340fdee7ed50937ba8e7f6bc7d17f81","html_url":"https://github.com/pallets/flask/commit/36e4a824f340fdee7ed50937ba8e7f6bc7d17f81"}],"stats":{"total":34,"additions":34,"deletions":0},"files":[{"sha":"fe3b97b4ff6fada6333c3f46d0ac8c6b221d55c5","filename":"examples/tutorial/Dockerfile","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/pallets/flask/blob/3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf/examples%2Ftutorial%2FDockerfile","raw_url":"https://github.com/pallets/flask/raw/3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf/examples%2Ftutorial%2FDockerfile","contents_url":"https://api.github.com/repos/pallets/flask/contents/examples%2Ftutorial%2FDockerfile?ref=3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf","patch":"@@ -0,0 +1,11 @@\n+FROM python:3.12-slim\n+\n+WORKDIR /app\n+\n+COPY . .\n+\n+RUN pip install -e .\n+\n+EXPOSE 5000\n+\n+CMD [\"flask\", \"--app\", \"flaskr\", \"run\", \"--host=0.0.0.0\"]"},{"sha":"5038c311ecae3c8716d99c3bc8d3bc3f38e0ca3e","filename":"examples/tutorial/deploy.sh","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/pallets/flask/blob/3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf/examples%2Ftutorial%2Fdeploy.sh","raw_url":"https://github.com/pallets/flask/raw/3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf/examples%2Ftutorial%2Fdeploy.sh","contents_url":"https://api.github.com/repos/pallets/flask/contents/examples%2Ftutorial%2Fdeploy.sh?ref=3d7aa8089d8bc5c0e7f15fdd40cde05182c3a6cf","patch":"@@ -0,0 +1,23 @@\n+#!/bin/bash\n+\n+IMAGE_NAME=\"flaskr-tutorial\"\n+CONTAINER_NAME=\"flaskr-container\"\n+\n+echo \"Building Docker image...\"\n+docker build -t $IMAGE_NAME .\n+\n+echo \"Stopping old container...\"\n+docker stop $CONTAINER_NAME 2>/dev/null\n+docker rm $CONTAINER_NAME 2>/dev/null\n+\n+echo \"Starting new container...\"\n+docker run -d --name $CONTAINER_NAME -p 5000:5000 $IMAGE_NAME\n+\n+echo \"Initializing database...\"\n+docker exec $CONTAINER_NAME flask --app flaskr init-db\n+\n+echo \"\"\n+echo \"Deployment Successful!\"\n+echo \"Container: $CONTAINER_NAME\"\n+echo \"Image: $IMAGE_NAME\"\n+echo \"URL: http://localhost:5000\""}]}