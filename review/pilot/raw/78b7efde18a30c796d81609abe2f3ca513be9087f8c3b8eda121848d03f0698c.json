l":"https://github.com/pallets/flask/blob/ae0392cbdd9c1fdf0f42a5c73080db25212d2959/tests%2Fconftest.py","raw_url":"https://github.com/pallets/flask/raw/ae0392cbdd9c1fdf0f42a5c73080db25212d2959/tests%2Fconftest.py","contents_url":"https://api.github.com/repos/pallets/flask/contents/tests%2Fconftest.py?ref=ae0392cbdd9c1fdf0f42a5c73080db25212d2959","patch":"@@ -3,6 +3,10 @@\n \n import pytest\n from _pytest import monkeypatch\n+try:\n+    from _pytest.compat import NOTSET as notset\n+except ImportError:\n+    from _pytest.monkeypatch import notset\n \n from flask import Flask\n from flask.globals import app_ctx as _app_ctx\n@@ -16,15 +20,15 @@ def _standard_os_environ():\n     \"\"\"\n     mp = monkeypatch.MonkeyPatch()\n     out = (\n-        (os.environ, \"FLASK_ENV_FILE\", monkeypatch.notset),\n-        (os.environ, \"FLASK_APP\", monkeypatch.notset),\n-        (os.environ, \"FLASK_DEBUG\", monkeypatch.notset),\n-        (os.environ, \"FLASK_RUN_FROM_CLI\", monkeypatch.notset),\n-        (os.environ, \"WERKZEUG_RUN_MAIN\", monkeypatch.notset),\n+        (os.environ, \"FLASK_ENV_FILE\", notset),\n+        (os.environ, \"FLASK_APP\", notset),\n+        (os.environ, \"FLASK_DEBUG\", notset),\n+        (os.environ, \"FLASK_RUN_FROM_CLI\", notset),\n+        (os.environ, \"WERKZEUG_RUN_MAIN\", notset),\n     )\n \n     for _, key, value in out:\n-        if value is monkeypatch.notset:\n+        if value is notset:\n             mp.delenv(key, False)\n         else:\n             mp.setenv(key, value)"},{"sha":"de9d14e4e50ac0ddbb5f562289d0467f7d64a678","filename":"tests/test_cli.py","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/pallets/flask/blob/ae0392cbdd9c1fdf0f42a5c73080db25212d2959/tests%2Ftest_cli.py","raw_url":"https://github.com/pallets/flask/raw/ae0392cbdd9c1fdf0f42a5c73080db25212d2959/tests%2Ftest_cli.py","contents_url":"https://api.github.com/repos/pallets/flask/contents/tests%2Ftest_cli.py?ref=ae0392cbdd9c1fdf0f42a5c73080db25212d2959","patch":"@@ -11,7 +11,10 @@\n \n import click\n import pytest\n-from _pytest.monkeypatch import notset\n+try:\n+    from _pytest.compat import NOTSET as notset\n+except ImportError:\n+    from _pytest.monkeypatch import notset\n from click.testing import CliRunner\n \n from flask import Blueprint"}]}