"sha":"af13558e3ce97b99c2864d2741eeff9849cd6601","filename":"lib/application.js","status":"modified","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/expressjs/express/blob/38278a671505ed1545f720b40433be04efd37b7b/lib%2Fapplication.js","raw_url":"https://github.com/expressjs/express/raw/38278a671505ed1545f720b40433be04efd37b7b/lib%2Fapplication.js","contents_url":"https://api.github.com/repos/expressjs/express/contents/lib%2Fapplication.js?ref=38278a671505ed1545f720b40433be04efd37b7b","patch":"@@ -569,6 +569,15 @@ app.render = function render(name, options, callback) {\n     // prime the cache\n     if (renderOptions.cache) {\n       cache[name] = view;\n+\n+      var callerDone = done;\n+      done = function (err, str) {\n+        // match the sync behavior: a view whose lookup failed is not kept\n+        if (err && !view.path) {\n+          delete cache[name];\n+        }\n+        callerDone(err, str);\n+      };\n     }\n   }\n "},{"sha":"cc3da5e1acc2b0f923dbfe54f1ed67165e28a346","filename":"test/app.render.js","status":"modified","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/expressjs/express/blob/38278a671505ed1545f720b40433be04efd37b7b/test%2Fapp.render.js","raw_url":"https://github.com/expressjs/express/raw/38278a671505ed1545f720b40433be04efd37b7b/test%2Fapp.render.js","contents_url":"https://api.github.com/repos/expressjs/express/contents/test%2Fapp.render.js?ref=38278a671505ed1545f720b40433be04efd37b7b","patch":"@@ -617,6 +617,28 @@ describe('app', function(){\n       })\n     })\n \n+    it('should not cache views whose lookup failed', function (done) {\n+      const app = createApp();\n+\n+      app.enable('view cache')\n+      app.set('views', path.join(__dirname, 'fixtures', 'local_layout')); // email.tmpl is not here\n+\n+      app.render('email.tmpl', function (err) {\n+        assert.ok(err)\n+        assert.ok(/^Failed to lookup view/.test(err.message))\n+\n+        // like the sync implementation, the failed view must not stick:\n+        // a new render honors the current settings\n+        app.set('views', path.join(__dirname, 'fixtures'));\n+\n+        app.render('email.tmpl', function (err2, str) {\n+          if (err2) return done(err2);\n+          assert.strictEqual(str, '<p>This is an email</p>')\n+          done();\n+        })\n+      })\n+    })\n+\n     it('should reuse the resolved path on subsequent renders', function (done) {\n       const app = createApp();\n "}]}